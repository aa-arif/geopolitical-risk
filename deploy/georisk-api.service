[Unit]
Description=GeoRisk Prediction API
After=network.target

[Service]
Type=simple
User=georisk
WorkingDirectory=/opt/georisk
EnvironmentFile=/opt/georisk/.env
ExecStart=/opt/georisk/venv/bin/uvicorn api.serve:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
